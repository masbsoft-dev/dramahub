// Dramahub — schema Prisma
// Portado 1:1 da secao 5 da "Especificacao Tecnica de Arquitetura Enterprise:
// Plataforma de Streaming VOD de Doramas" (docs/design-reference).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ContentCountry {
  KR // Coreia do Sul
  CN // China
  JP // Japao
  TW // Taiwan
  TH // Tailandia
}

enum Role {
  USER
  ADMIN
}

// -------------------------------------------------------------
// USER & IDENTITY (Sem multiplos perfis)
// -------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  cpf          String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscription      Subscription?
  registeredDevices Device[]
  watchProgresses   UserWatchProgress[]
  favoriteDramas    UserFavorite[]
  dramaReactions    UserDramaReaction[]
  playlistImports   PlaylistImport[]
}

model Device {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String // Hash unico do dispositivo
  deviceName  String // Ex: Chrome 128 / Android TV
  lastIp      String
  lastSeenAt  DateTime @updatedAt

  @@unique([userId, fingerprint])
}

// -------------------------------------------------------------
// SUBSCRIPTION & BILLING (Plano 1080p + Add-on de Telas Extra)
// -------------------------------------------------------------

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(ACTIVE)
  baseQuality          String             @default("1080p")
  extraScreensCount    Int                @default(0) // Telas adicionais compradas (Max: 3)
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// -------------------------------------------------------------
// CATALOG & MEDIA ENGINE
// -------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum MediaFormat {
  HLS // manifesto .m3u8, tocado via hls.js/proxy com reescrita de URIs
  MP4 // arquivo unico, proxeado direto com suporte a Range
  DASH // .mpd — aceito no contrato de ingestao, sem proxy implementado ainda
}

model Drama {
  id              String         @id @default(uuid())
  titlePortuguese String
  titleOriginal   String?
  synopsis        String         @db.Text
  countryOrigin   ContentCountry @default(KR)
  releaseYear     Int
  posterUrl       String
  bannerUrl       String
  rating          Decimal?       @db.Decimal(3, 1)
  status          ContentStatus  @default(PUBLISHED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  genres              DramaGenre[]
  seasons             Season[]
  episodes            Episode[]
  castMembers         CastMember[]
  soundtrackTracks    SoundtrackTrack[]
  favorites           UserFavorite[]
  reactions           UserDramaReaction[]
  playlistImportItems PlaylistImportItem[]

  @@index([countryOrigin])
  @@index([status])
}

model Season {
  id           String   @id @default(uuid())
  dramaId      String
  drama        Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  seasonNumber Int
  title        String?
  posterUrl    String?
  synopsis     String?  @db.Text
  createdAt    DateTime @default(now())

  episodes Episode[]

  @@unique([dramaId, seasonNumber])
}

model CastMember {
  id        String @id @default(uuid())
  dramaId   String
  drama     Drama  @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  actorName String
  roleName  String?
  photoUrl  String?
  order     Int    @default(0)
}

model SoundtrackTrack {
  id              String  @id @default(uuid())
  dramaId         String
  drama           Drama   @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  title           String
  artistName      String?
  audioUrl        String?
  durationSeconds Int?
  order           Int     @default(0)
}

model Genre {
  id     String       @id @default(uuid())
  name   String       @unique
  dramas DramaGenre[]
}

model DramaGenre {
  dramaId String
  genreId String
  drama   Drama  @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([dramaId, genreId])
}

model Episode {
  id              String      @id @default(uuid())
  dramaId         String
  drama           Drama       @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  seasonId        String
  season          Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber   Int
  title           String?
  posterUrl       String? // sobrepoe o poster da temporada/dorama na listagem, se definido
  manifestUrl     String // URL .m3u8 / .mpd / .mp4 extraida
  format          MediaFormat @default(HLS) // como o proxy deve tratar manifestUrl
  headersJson     Json? // Headers necessarios para o Proxy (Referer, Origin, Cookies)
  durationSeconds Int?
  createdAt       DateTime    @default(now())

  subtitles       Subtitle[]
  watchProgresses UserWatchProgress[]

  @@unique([seasonId, episodeNumber])
}

model Subtitle {
  id        String  @id @default(uuid())
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  language  String // pt-BR, en-US, ko-KR
  vttUrl    String
}

// -------------------------------------------------------------
// USER ENGAGEMENT & HISTORY
// -------------------------------------------------------------

model UserWatchProgress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId        String
  episode          Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  stoppedAtSeconds Int
  isFinished       Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  @@unique([userId, episodeId])
}

model UserFavorite {
  userId    String
  dramaId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, dramaId])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model UserDramaReaction {
  userId    String
  dramaId   String
  type      ReactionType
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama     Drama        @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([userId, dramaId])
}

// -------------------------------------------------------------
// ADMIN — IMPORTACAO DE PLAYLIST M3U (generico, agnostico de fonte)
// -------------------------------------------------------------

enum PlaylistItemKind {
  CHANNEL
  MOVIE
  SERIES
  UNKNOWN
}

enum PlaylistItemStatus {
  PENDING
  IMPORTED
  SKIPPED
}

model PlaylistImport {
  id              String   @id @default(uuid())
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  sourceLabel     String
  itemCount       Int      @default(0)
  createdAt       DateTime @default(now())

  items PlaylistImportItem[]
}

model PlaylistImportItem {
  id             String              @id @default(uuid())
  importId       String
  import         PlaylistImport      @relation(fields: [importId], references: [id], onDelete: Cascade)
  kind           PlaylistItemKind
  name           String
  groupTitle     String?
  logoUrl        String?
  streamUrl      String              @db.Text
  tvgId          String?
  status         PlaylistItemStatus  @default(PENDING)
  createdDramaId String?
  createdDrama   Drama?              @relation(fields: [createdDramaId], references: [id], onDelete: SetNull)

  @@index([importId, kind])
  @@index([importId, status])
}
